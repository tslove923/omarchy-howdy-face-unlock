#!/bin/bash
# Detect update drift without using omarchy-update's warm sudo credential.
# This hook is user-writable; it must never run plugin-checkout code as root.
set -u

PLUGIN_DIR="$HOME/.config/omarchy/plugins/io.github.tslove923.howdy-face-unlock"
[[ -f $PLUGIN_DIR/manifest.json ]] || exit 0

LOCK_QML="${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/lock/Service.qml"
[[ -f $LOCK_QML ]] || LOCK_QML="/usr/share/omarchy/shell/plugins/lock/Service.qml"

if [[ -f $LOCK_QML ]] && ! grep -q 'omarchy-lock-howdy' "$LOCK_QML"; then
  echo "Howdy Face Unlock: Omarchy replaced the lock-screen patch. Run $PLUGIN_DIR/setup --cli to restore it." >&2
fi

# Explorer's adapter also requires an explicit setup rerun to refresh.
exit 0
