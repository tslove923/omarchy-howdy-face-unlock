#!/bin/bash

# omarchy plugin add only clones files, so this is the rest of the install.
# Run it yourself after cloning: ~/.config/omarchy/plugins/<id>/setup

set -e

root=$(cd "$(dirname "$0")" && pwd)
no_enroll=false
selected_camera=""
cli_mode=false
wizard_mode=false
while (( $# )); do
  case "$1" in
    --no-enroll) no_enroll=true; shift ;;
    --camera) [[ $# -ge 2 ]] || { echo "--camera needs a device" >&2; exit 2; }; selected_camera=$2; shift 2 ;;
    --cli) cli_mode=true; shift ;;
    --wizard) wizard_mode=true; shift ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
done
# Setup menu and the documented first-run command open the wizard on a live
# desktop. The wizard calls back with --no-enroll/--camera for the actual
# privileged install. Keep --cli for headless and recovery use.
if [[ $cli_mode == false && $no_enroll == false && -z $selected_camera && -n ${WAYLAND_DISPLAY:-} ]] && command -v omarchy-shell >/dev/null 2>&1; then
  # Build outside the plugin directory: Quickshell watches that tree and
  # reloading it during a Cargo build closes the wizard mid-setup.
  omarchy-pkg-add rust dlib v4l-utils
  "$root/ui/backend" status >/dev/null
  if timeout 5 omarchy-shell howdy open >/dev/null 2>&1; then exit 0; fi
  timeout 5 omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  if timeout 5 omarchy-shell howdy open >/dev/null 2>&1; then exit 0; fi
  echo "Could not open the Howdy wizard; restart the Omarchy shell and try again." >&2
  exit 1
fi

CONFIG_DIR="/etc/howdy"
MODELS_DIR="$CONFIG_DIR/models"
CONFIG_FILE="$CONFIG_DIR/config.ini"
PAM_HOWDY="/etc/pam.d/omarchy-lock-howdy"
# The shell loads its plugins from $OMARCHY_PATH/shell on a dev checkout but
# from /usr/share/omarchy/shell on a packaged install -- patch whichever copy
# the running shell actually reads, falling back if the variable is unset.
LOCK_QML="${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/lock/Service.qml"
[[ -f $LOCK_QML ]] || LOCK_QML="/usr/share/omarchy/shell/plugins/lock/Service.qml"
LOCK_QML_ORIG="$LOCK_QML.orig"
# Expected sha256 of patch-lock-howdy.py at this commit. Root verifies the
# staged copy against this fixed value before executing it (see the patch
# step below) -- bump this alongside any change to that file.
PATCHER_SHA256="bff504407a9cc6527861a081d4bbc8f44549b1aa67547a1c2cfddaf0e8bcd136"

# Sets/inserts key = value inside [section] of an ini file without disturbing
# anything else in it -- howdy's config.ini is heavily commented, and a
# configparser-style rewrite would throw all of that away.
set_ini() {
  local file=$1 section=$2 key=$3 value=$4
  awk -v section="[$section]" -v key="$key" -v value="$value" '
    BEGIN { in_section = 0; done = 0 }
    $0 == section { in_section = 1; print; next }
    in_section && /^\[/ {
      if (!done) { print key " = " value; done = 1 }
      in_section = 0
      print
      next
    }
    in_section && $0 ~ "^" key "[[:space:]]*=" {
      print key " = " value
      done = 1
      next
    }
    { print }
    END { if (in_section && !done) print key " = " value }
  ' "$file" | sudo tee "$file.tmp" >/dev/null && sudo mv "$file.tmp" "$file"
}

echo -e "\e[32mSetting up face unlock (Howdy) for the lock screen.\n\e[0m"

# Bail before installing anything if there's no IR camera to use. A color-only
# webcam can technically run Howdy too, but it's far less reliable across
# lighting and isn't what this flow is tuned for.
if [[ -n $selected_camera ]]; then
  # The wizard offers only enumerated video nodes; validate again at the
  # privileged boundary, including the symlink target after re-enumeration.
  [[ $selected_camera == /dev/video[0-9]* || $selected_camera == /dev/v4l/by-id/* ]] || { echo "Invalid camera path" >&2; exit 2; }
  [[ -c $selected_camera && $(readlink -f "$selected_camera") == /dev/video[0-9]* ]] || { echo "Camera no longer exists" >&2; exit 2; }
  ir_device=$selected_camera
else
  ir_device=$("$root/bin/omarchy-hw-ir-camera") || {
    echo -e "\e[31mNo infrared camera detected.\e[0m"
    exit 1
  }
fi
echo "Found infrared camera at $ir_device."

# `sudo -v` asks for a password even on Omarchy installations where the
# required commands already work with passwordless sudo. Avoid an unnecessary
# terminal prompt when the wizard (or remote setup) can proceed unattended.
if ! sudo -n true 2>/dev/null; then
  source omarchy-sudo-keepalive
fi

echo -e "\nInstalling required packages...\n"
omarchy-pkg-add v4l-utils dlib rust
"$root/ui/backend" status >/dev/null

# python-dlib's AUR PKGBUILD defaults to building its CUDA subpackage, which
# fails to build without an actual Nvidia GPU/toolkit present. Only attempt
# it when there's real Nvidia hardware to justify it.
if omarchy-pkg-missing python-dlib; then
  if lspci -nn 2>/dev/null | grep -qi nvidia; then
    echo "Nvidia GPU detected -- building python-dlib with CUDA support..."
    yay -S --noconfirm --needed python-dlib
  else
    echo "No Nvidia GPU detected -- building python-dlib CPU-only..."
    build_dir=$(mktemp -d)
    # Pin the AUR checkout to a fixed commit SHA so a later upstream move can't
    # silently change what gets built (marketplace security baseline).
    git init -q "$build_dir"
    git -C "$build_dir" remote add origin https://aur.archlinux.org/python-dlib.git
    git -C "$build_dir" fetch -q --depth 1 origin 84910843274aa2989f0ebb3cba3347ba7c78f6b8
    git -C "$build_dir" checkout -q --detach 84910843274aa2989f0ebb3cba3347ba7c78f6b8 \
      && sed -i 's/^_build_cuda=.*/_build_cuda=0/' "$build_dir/PKGBUILD" \
      && (cd "$build_dir" && makepkg -si --noconfirm)
    rm -rf "$build_dir"
    # Reset the working directory: the build above ran in a subshell, but the
    # static scanner attributes the `cd "$build_dir"` to the rest of the script.
    # Nothing downstream depends on cwd (all paths are absolute), and leaving
    # it pointing at the now-deleted directory is misleading.
    cd /
  fi
fi

omarchy-pkg-aur-add howdy-git

echo -e "\nConfiguring Howdy...\n"
sudo mkdir -p "$MODELS_DIR"
[[ -f $CONFIG_FILE ]] || sudo howdy config >/dev/null 2>&1 || true  # lay down howdy's default file first

# IR sensors run dark, so the histogram threshold and certainty defaults need
# loosening from what works for a color camera. This is a reasonable starting
# point across IR webcams, not a guarantee -- `sudo howdy config` opens the
# file directly if a particular camera needs more.
set_ini "$CONFIG_FILE" core workaround off
set_ini "$CONFIG_FILE" video device_path "$ir_device"
set_ini "$CONFIG_FILE" video dark_threshold 95
set_ini "$CONFIG_FILE" video certainty 3.0
set_ini "$CONFIG_FILE" video max_height 320

# The lock screen calls pam_howdy.so from the user's own unprivileged shell
# process (no setuid helper, no root daemon -- unlike fprintd/D-Bus), so it
# has to be able to read its own config directly as that user.
sudo chmod 644 "$CONFIG_FILE"

# Enroll a face model if this user doesn't have one yet.
if [[ $no_enroll == false && ! -f "$MODELS_DIR/$USER.dat" ]]; then
  echo -e "\nLet's add your face. Look at the camera and hold still.\n"
  sudo howdy add
fi

echo -e "\nConfiguring lock screen for Howdy authentication...\n"
sudo tee "$PAM_HOWDY" >/dev/null <<'EOF'
#%PAM-1.0
auth       required                    pam_howdy.so
account    include                     system-local-login
EOF

# Patch the lock plugin to run Howdy as its own path, parallel to (and
# independent of) fingerprint's. `omarchy update` overwrites this file since
# it's package-owned, so this step is designed to be safely rerun -- it
# no-ops once the patch is already present, and reapplies cleanly if an
# update wiped it. This plugin's Service.qml notices that and tells you to
# rerun this script when it happens.
if ! grep -q 'omarchy-lock-howdy' "$LOCK_QML"; then
  echo "Patching lock screen plugin for Howdy..."
  [[ -f $LOCK_QML_ORIG ]] || sudo cp -a "$LOCK_QML" "$LOCK_QML_ORIG"
  # Root stages both the QML and the patcher into a root-owned scratch dir
  # before touching either, so nothing it reads is a path the invoking user
  # can still write to *by name*. That alone isn't enough, though: the sudo
  # timestamp is already warm from the calls above, so the user-writable
  # checkout this cp reads from could be swapped right up until the cp runs
  # -- moving the read into a root-owned dir shrinks the window but doesn't
  # close it, since root still executed whatever bytes were staged. Root
  # closes it for real by checking what actually got staged, not where it
  # came from: verify the copy's hash against the value pinned above before
  # ever executing it, and refuse on mismatch. After that, the copy can come
  # from anywhere -- root has independently established what it's about to run.
  scratch_dir=$(sudo mktemp -d)
  sudo cp "$LOCK_QML" "$scratch_dir/Service.qml"
  sudo cp "$root/patch-lock-howdy.py" "$scratch_dir/patch-lock-howdy.py"
  staged_sha256=$(sudo sha256sum "$scratch_dir/patch-lock-howdy.py" | awk '{print $1}')
  if [[ $staged_sha256 != "$PATCHER_SHA256" ]]; then
    sudo rm -rf "$scratch_dir"
    echo -e "\e[31mpatch-lock-howdy.py hash mismatch (expected $PATCHER_SHA256, got $staged_sha256).\e[0m" >&2
    echo -e "\e[31mRefusing to run it as root. Re-clone this plugin and try again.\e[0m" >&2
    exit 1
  fi
  sudo chmod 500 "$scratch_dir/patch-lock-howdy.py"
  sudo python3 "$scratch_dir/patch-lock-howdy.py" "$scratch_dir/Service.qml"
  sudo install -o root -g root -m 644 "$scratch_dir/Service.qml" "$LOCK_QML"
  sudo rm -rf "$scratch_dir"
  if [[ $wizard_mode == false ]]; then omarchy-restart-shell; fi
fi

# Lock Screen Explorer (io.github.sirjul1337.lock-explorer) is a
# `clonedFrom: omarchy.lock` replacement -- when it's enabled, Omarchy
# disables the stock lock plugin patched above and loads Explorer's own
# Service.qml for the `lock` IPC target instead (see the README's
# "Lock-screen replacement plugins" section, and issue #1). Patch its copy
# too, whenever it's installed, regardless of whether
# it's the currently *enabled* target -- so Howdy is already wired in
# however and whenever the user switches between the two.
#
# Unlike the stock file above, Explorer's Service.qml lives in the user's
# own plugin checkout (~/.config/omarchy/plugins/...), not a package-owned
# system path -- the invoking user already owns it outright, so patching it
# doesn't cross a privilege boundary the way writing to /usr/share/omarchy
# does. That's why this step runs the patcher directly instead of the
# root-owned-scratch-dir-plus-hash-verification dance above: that dance
# defends against a warm sudo timestamp being used to run tampered bytes
# as root. With no privilege escalation here, anyone who could tamper with
# this patcher could equally tamper with anything else this user's own
# shell already trusts (~/.bashrc and so on) -- the extra ceremony
# wouldn't buy anything real.
#
# Also unlike the stock step, a failure here does NOT abort setup: Lock
# Screen Explorer is a fast-moving third-party plugin outside this
# project's control, and its structure *will* eventually drift out from
# under patch-lock-howdy-explorer.py's anchors (see that file's
# docstring). When that happens, the rest of Howdy's install (packages,
# camera, enrollment, the stock lock patch, the drift-detection hook) should
# still succeed -- Explorer compatibility is a bonus, not a precondition.
# ---- Optional: Lock Screen Explorer compatibility -------------------------
#
# Lock Screen Explorer (io.github.sirjul1337.lock-explorer) ships its own
# native face-unlock UI, but it can only drive a facelock-shaped backend: it
# hardcodes PamContext config "omarchy-lock-face" and only offers the face UI
# when its own check-face-auth.sh finds pam_facelock.so, /var/lib/facelock
# models, and so on. Omarchy has no plugin-to-plugin auth hook and none of
# that is user-configurable, so running Howdy behind Explorer's face UI means
# providing that facelock-shaped surface ourselves -- backed by Howdy.
#
# We do this WITHOUT touching any file inside Explorer's tree, so it is
# install-order independent (it does not matter whether Explorer is present
# yet) and survives `omarchy plugin update`, which would revert a patched
# Service.qml. The files this creates are:
#
#   /etc/pam.d/omarchy-lock-face      -- the PAM service Explorer calls
#   /usr/lib/security/pam_facelock.so -- symlink to pam_howdy.so
#   /var/lib/facelock/models/*.onnx   -- symlinks to your Howdy models
#
# In other words: it makes Explorer's "facelock" face path resolve to Howdy.
# The facelock names are Explorer's vocabulary; everything they point at is
# Howdy. Nothing here claims facelock is installed to anything but Explorer's
# own detector, and a real facelock install (its module/daemon) is never
# shadowed -- this step backs off if it finds one.
#
# This is opt-in: it writes files outside the plugin's own directory, so we
# ask first. Skipping it changes nothing for the stock lock screen, which is
# patched above regardless.
adapter_wanted=no
if [[ -f $HOME/.config/omarchy/plugins/io.github.sirjul1337.lock-explorer/manifest.json ]]; then
  echo
  echo "Lock Screen Explorer is installed. To use Howdy as its face backend, this"
  echo "plugin can provide a small facelock-shaped compatibility surface (it writes:"
  echo "  /etc/pam.d/omarchy-lock-face, a pam_facelock.so -> pam_howdy.so symlink,"
  echo "  and /var/lib/facelock/models symlinks). Nothing in Explorer's own files"
  echo "is modified. A real facelock install is left alone."
  if [[ $wizard_mode == true ]]; then reply=n; else read -r -p "Set up Lock Screen Explorer compatibility? [y/N] " reply || true; fi
  case "${reply:-}" in [yY]|[yY][eE][sS]) adapter_wanted=yes ;; esac
else
  # Not installed yet -- still offer it, so the surface is ready if Explorer is
  # added later (this is what makes the step install-order independent).
  echo
  echo "Lock Screen Explorer is not installed. You can still pre-provision the"
  echo "facelock-shaped surface now so Howdy backs Explorer's face UI the moment"
  echo "you add it later. It only creates files outside Explorer's tree."
  if [[ $wizard_mode == true ]]; then reply=n; else read -r -p "Pre-provision Lock Screen Explorer compatibility? [y/N] " reply || true; fi
  case "${reply:-}" in [yY]|[yY][eE][sS]) adapter_wanted=yes ;; esac
fi

if [[ $adapter_wanted == yes ]]; then
  echo "Providing the facelock-shaped lock-screen surface (for Lock Screen Explorer)..."
  if bash "$root/bin/howdy-lock-face-adapter" install; then
    :
  else
    echo -e "\e[33mCouldn't install the Howdy lock-screen adapter -- continuing without\e[0m"
    echo -e "\e[33mExplorer support. Howdy still works with the stock lock screen.\e[0m"
  fi
else
  echo "Skipping Lock Screen Explorer compatibility."
fi

# ---- Optional: face unlock for sudo and polkit ----------------------------
#
# Face unlock is a convenience for the person sitting at the machine, so this
# only ever sits in front of an interactive prompt: pam_unix is kept first with
# try_first_pass (a typed password authenticates as before; only an empty Enter
# triggers a scan), and howdy itself aborts for SSH sessions and when the lid
# is closed. It changes how root escalation authenticates, so it is opt-in --
# but defaulting to yes, since a laptop with an IR camera is exactly the case
# it is for. See bin/howdy-sudo-adapter.
sudo_wanted=no
if [[ -d /etc/howdy ]]; then
  echo
  echo "Wire face unlock into sudo and polkit as well? A typed password still"
  echo "works; face is only tried when you press Enter on an empty prompt."
  if [[ $wizard_mode == true ]]; then reply=n; else read -r -p "Wire face unlock into sudo and polkit? [Y/n] " reply || true; fi
  case "${reply:-}" in [nN]|[nN][oO]) sudo_wanted=no ;; *) sudo_wanted=yes ;; esac
fi

if [[ $sudo_wanted == yes ]]; then
  echo "Wiring face unlock into sudo and polkit..."
  if bash "$root/bin/howdy-sudo-adapter" install; then
    :
  else
    echo -e "\e[33mCouldn't wire face unlock into sudo/polkit -- continuing. The lock\e[0m"
    echo -e "\e[33mscreen is unaffected; sudo and polkit just keep using your password.\e[0m"
  fi
else
  echo "Skipping sudo/polkit face unlock."
fi

# Note which lock screen Howdy will actually back right now -- Omarchy loads
# only one `lock`-targeting service at a time.
if command -v omarchy >/dev/null 2>&1; then
  explorer_active=$(omarchy plugin list --json 2>/dev/null | python3 -c '
import json, sys
try:
    plugins = json.load(sys.stdin)
except Exception:
    plugins = []
print("yes" if any(p.get("id") == "io.github.sirjul1337.lock-explorer" and p.get("enabled") for p in plugins) else "no")
' 2>/dev/null)
  if [[ $explorer_active == yes ]]; then
    echo -e "\e[33mNote: Lock Screen Explorer is enabled, so it -- not the stock lock\e[0m"
    echo -e "\e[33mscreen -- is what runs when you lock. The facelock-shaped surface\e[0m"
    echo -e "\e[33m(if you accepted it above) is what backs its face UI, with Howdy\e[0m"
    echo -e "\e[33munderneath; the stock patch is dormant until you disable Explorer.\e[0m"
  fi
fi

# Omarchy updates may replace the package-owned lock file. The post-update
# hook only detects drift; it never spends an update's warm sudo credential
# on code from this user-writable plugin checkout. Rerun setup explicitly.
if command -v omarchy >/dev/null 2>&1; then
  omarchy hook install post-update "$root/hooks/post-update.d/repair-howdy-lock.hook"
else
  echo -e "\e[33mCouldn't find 'omarchy' to install the drift-detection hook -- \e[0m"
  echo -e "\e[33myou'll need to rerun this script by hand after updates instead.\e[0m"
fi

echo -e "\e[32m\nDone! Howdy will now try face unlock alongside your password"
echo -e "(and fingerprint, if set up) whenever the lock screen engages.\e[0m"
echo
echo "Note: the lock screen change above patches a file the omarchy package"
echo "owns (lock/Service.qml), so an 'omarchy update' can silently revert it."
echo "The post-update hook only reports a reverted lock patch; rerun"
echo "setup --cli to restore it. It never uses an update's sudo session."
echo
echo "Lock Screen Explorer support is provided via a facelock-shaped surface"
echo "(Howdy behind it), written outside Explorer's tree -- so an Explorer"
echo "update can't revert it, and no repair hook is needed for it."
