#!/bin/bash
# Unwire this plugin's system changes before removing its checkout.
set -euo pipefail
root=$(cd "$(dirname "$0")" && pwd)
PAM_HOWDY=/etc/pam.d/omarchy-lock-howdy
LOCK_QML="${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/lock/Service.qml"
[[ -f $LOCK_QML ]] || LOCK_QML=/usr/share/omarchy/shell/plugins/lock/Service.qml
HOOK="$HOME/.config/omarchy/hooks/post-update.d/repair-howdy-lock.hook"

echo "Removing Howdy Face Unlock integration..."
if ! sudo -n true 2>/dev/null; then
  sudo -v
fi

# Validate the reversal before changing any PAM integration. A stale backup
# may predate an Omarchy update, so never restore it over current QML.
scratch=""
if [[ -f $LOCK_QML ]] && grep -q 'omarchy-lock-howdy' "$LOCK_QML"; then
  scratch=$(mktemp)
  cp "$LOCK_QML" "$scratch"
  if ! python3 "$root/unpatch-lock-howdy.py" "$scratch"; then
    rm -f "$scratch"
    exit 1
  fi
fi
trap '[[ -z $scratch ]] || rm -f "$scratch"; [[ -z ${expected:-} ]] || rm -f "$expected"' EXIT

# These scripts invoke only specific sudo utilities; never run a user-writable
# checkout script as root with a potentially warm sudo timestamp.
bash "$root/bin/howdy-lock-face-adapter" remove
bash "$root/bin/howdy-sudo-adapter" remove

if [[ -n $scratch ]]; then
  sudo install -o root -g root -m 644 "$scratch" "$LOCK_QML"
  echo "Removed Howdy from the stock lock screen without replacing newer Omarchy code."
  omarchy-restart-shell
fi

if [[ -f $PAM_HOWDY ]]; then
  expected=$(mktemp)
  cat > "$expected" <<'PAM'
#%PAM-1.0
auth       required                    pam_howdy.so
account    include                     system-local-login
PAM
  if sudo cmp -s "$expected" "$PAM_HOWDY"; then
    sudo rm "$PAM_HOWDY"
    echo "Removed $PAM_HOWDY"
  else
    echo "PAM service differs from this plugin's template; leaving $PAM_HOWDY untouched." >&2
  fi
fi

if [[ -f $HOOK ]] && grep -qF 'PLUGIN_DIR="$HOME/.config/omarchy/plugins/io.github.tslove923.howdy-face-unlock"' "$HOOK"; then
  rm "$HOOK"
  echo "Removed the post-update hook."
fi

# Keep Howdy packages, config, and enrolled models: other consumers may use
# them and deleting face data is an explicit, separate decision.
echo "Plugin integration removed. Howdy packages, config, and enrolled models were retained."
echo "To remove the plugin checkout: omarchy plugin remove io.github.tslove923.howdy-face-unlock"
